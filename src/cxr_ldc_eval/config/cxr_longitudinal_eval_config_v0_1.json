        "Do not expand GLOBAL_NO_CHANGE to all diseases."
      ]
    },
    "level_direction_f1": {
      "applies_to_question_types": [
        "level"
      ],
      "primary_tuple": [
        "entity",
        "severity_transition"
      ],
      "scored_values": [
        "WORSENED",
        "IMPROVED",
        "SAME_LEVEL",
        "LEVEL_CHANGED_UNSPECIFIED"
      ],
      "include_presence_requirement": "PRESENT_BOTH is assumed for IMPROVED/WORSENED/SAME_LEVEL unless evidence says otherwise.",
      "secondary_metrics": [
        "level_value_exact_accuracy",
        "level_ordinal_distance",
        "entity_f1"
      ],
      "special_rules": [
        "If answer only gives a level word and disease is in question, inherit entity from question.",
        "If both reference and current levels are present, compute direction via severity_lexicon."
      ]
    },
    "current_presence_accuracy": {
