  "transitions": {
    "presence_transition": {
      "NEW": {
        "definition": "Finding is present in main/current/follow-up and absent or not described in reference/baseline.",
        "positive_patterns": [
          "additional finding",
          "additional findings",
          "new",
          "newly",
          "interval development",
          "developed",
          "appeared",
          "increased presence",
          "now seen"
        ],
        "negative_patterns": [
          "no new",
          "not new",
          "without new",
          "no additional",
          "not additional",
          "without additional"
        ],
        "template_patterns": [
          "the main image has an additional finding of {entities} than the reference image",
          "the main image has additional findings of {entities} than the reference image"
        ]
      },
      "RESOLVED": {
        "definition": "Finding was present in reference/baseline and is absent/missing/resolved in main/current/follow-up.",
        "positive_patterns": [
          "missing the finding",
          "missing the findings",
          "resolved",
          "no longer seen",
          "disappeared",
          "cleared",
          "interval resolution",
          "removed"
        ],
        "negative_patterns": [
          "partially resolved"
        ],
        "template_patterns": [
          "the main image is missing the finding of {entities} than the reference image",
          "the main image is missing the findings of {entities} than the reference image"
        ]
      },
      "PRESENT_BOTH": {
        "definition": "Finding is present at both time points. In Change-Presence evaluation, IMPROVED, WORSENED, SAME_LEVEL, persistent, and unchanged disease are all projected here.",
        "positive_patterns": [
          "persistent",
          "again seen",
          "redemonstrated",
          "present in both",
          "unchanged",
          "stable",
          "similar",
          "improved",
          "worsened",
          "increased",
          "decreased",
          "level has changed"
        ],
        "projection_sources": [
          "WORSENED",
          "IMPROVED",
          "SAME_LEVEL",
          "LEVEL_CHANGED_UNSPECIFIED"
        ]
      },
      "ABSENT_BOTH": {
        "definition": "Finding is absent at both time points. Usually relevant to presence questions, not generic change answers.",
        "positive_patterns": [
          "no evidence of",
          "absent",
          "not seen",
          "without"
        ],
        "use_rule": "Do not infer RESOLVED from a non-comparative 'no X' phrase unless comparative wording is explicit."
      },
      "GLOBAL_NO_CHANGE": {
        "definition": "Answer states no relevant change overall; do not expand to all 31 diseases as UNCHANGED.",
        "positive_patterns": [
          "nothing has changed",
          "no significant change",
          "no interval change"
        ],
        "template_patterns": [
          "nothing has changed"
        ]
      },
      "UNKNOWN": {
        "definition": "Direction cannot be determined from answer text."
      }
    },
    "severity_transition": {
      "WORSENED": {
        "definition": "Disease remains present and severity/size/extent increased.",
        "positive_patterns": [
          "worsened",
          "worse",
          "increased",
          "larger",
          "progressed",
          "more severe",
          "greater",
          "from mild to moderate",
          "from small to large"
        ]
      },
      "IMPROVED": {
        "definition": "Disease remains present and severity/size/extent decreased.",
        "positive_patterns": [
          "improved",
          "decreased",
          "smaller",
          "less",
          "less severe",
          "partially resolved",
          "from moderate to mild",
          "from large to small"
        ]
      },
      "SAME_LEVEL": {
        "definition": "Disease remains present and severity is stable/unchanged.",
        "positive_patterns": [
          "unchanged",
          "stable",
          "similar",
          "same level",
          "no change in level"
        ]
      },
      "LEVEL_CHANGED_UNSPECIFIED": {
        "definition": "A level change is claimed, but direction cannot be computed reliably.",
        "positive_patterns": [
          "level has changed",
          "changed in severity"
        ]
      },
      "NOT_APPLICABLE": {
        "definition": "Used for NEW/RESOLVED claims where ordinal severity comparison is not requested or not meaningful."
      },
      "UNKNOWN": {
        "definition": "Severity direction cannot be determined."
      }
    }
  },
