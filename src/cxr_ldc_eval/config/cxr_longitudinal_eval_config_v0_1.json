  "parser_patterns": {
    "sentence_split": "split on period followed by whitespace; preserve source sentence",
    "new_clause_regex": "the main image has (?:an? )?additional findings? of (?P<entities>.+?)(?: than the reference image)?$",
    "resolved_clause_regex": "the main image is missing the findings? of (?P<entities>.+?)(?: than the reference image)?$",
    "level_clause_regex": "the level of (?P<entity>.+?) has changed from (?P<reference_level>.+?) to (?P<current_level>.+)$",
    "global_no_change_regex": "^(nothing has changed|no significant change|no interval change)\\.?$",
    "entity_list_split_regex": ",\\s*|\\s+and\\s+",
    "malformed_span_recovery": "After list splitting, run longest-first alias matching inside each segment; this recovers malformed spans such as 'and pneumonia lung opacity'."
  },
  "evaluation_profiles": {
    "change_presence_f1": {
      "applies_to_question_types": [
        "difference"
      ],
      "primary_tuple": [
        "entity",
        "presence_transition"
      ],
      "projection": {
        "NEW": "NEW",
        "RESOLVED": "RESOLVED",
        "PRESENT_BOTH": "PRESENT_BOTH",
        "WORSENED": "PRESENT_BOTH",
        "IMPROVED": "PRESENT_BOTH",
        "SAME_LEVEL": "PRESENT_BOTH",
        "LEVEL_CHANGED_UNSPECIFIED": "PRESENT_BOTH"
      },
      "scored_values": [
        "NEW",
        "RESOLVED",
        "PRESENT_BOTH"
      ],
      "do_not_score_axes": [
        "severity_transition",
        "level_value"
      ],
      "safety_metrics": [
        "explicit_severity_contradiction_rate",
        "presence_transition_contradiction_rate",
